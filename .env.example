# 复制为 .env.local 后填入实际值

# ─── AI 解读（OpenAI 兼容协议，任选一家）───
# 本仓库已实现 /api/interpret（见 app/api/interpret/route.ts），填上密钥即可用。
# 排盘、真太阳时、四化、格局识别都不需要密钥，不填也能正常看盘。
#
# 密钥只从服务端读取（route 里有 runtime='nodejs'），不会进浏览器包。
# 未配置时接口返回 503 与配置指引，界面上会直接显示这段提示。

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 或任意 OpenAI 兼容服务（OpenAI / 硅基流动 / 通义 / 自建 vLLM 等）───
# AI_PROVIDER=custom
# AI_API_KEY=your-api-key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ─── 可选调参 ───
# 命理断语需要稳定复现，温度不建议超过 1.0
# AI_TEMPERATURE=0.8
# AI_MAX_TOKENS=2048

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
